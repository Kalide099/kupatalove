# KupataLove Backend — Environment Variables

# Server
PORT=3000
NODE_ENV=production
FRONTEND_URL=kupatalove.com

# JWT
JWT_SECRET=kupatalove_super_secret_jwt_key_change_in_production_2024
JWT_REFRESH_SECRET=kupatalove_refresh_secret_key_change_in_production_2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kupatalove
DB_USER=root
DB_PASS=

# OpenAI (replace with your key)
OPENAI_API_KEY=sk-placeholder-replace-with-your-openai-key

# Stripe (replace with your test keys)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_webhook_secret
STRIPE_GOLD_PRICE_ID=price_placeholder_gold
STRIPE_PLATINUM_PRICE_ID=price_placeholder_platinum

# Translation (LibreTranslate public instance)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
